# Copia este archivo como .env y completa tus valores. Nunca subas .env al repositorio.

# Proveedor del LLM: gemini (por defecto) u openai (API compatible: Groq, OpenRouter, Ollama…)
LLM_PROVIDER=gemini

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Alternativa (opcional) con API compatible con OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Parámetros del motor conversacional
NLU_CONFIDENCE_THRESHOLD=0.5
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.35
CONVERSATION_LOGGING=true
# Pausa (ms) entre llamadas durante la evaluación, para respetar el límite por minuto del plan gratuito
EVAL_DELAY_MS=4500
